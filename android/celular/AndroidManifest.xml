<?xml version="1.0" encoding="utf-8"?>
<!-- Sin permiso de internet: los archivos se sirven desde adentro de la app. FeniXVOID · Project Ravenlight -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="net.ravenlight.shadowmoses">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:label="Shadow Moses" android:icon="@mipmap/ic_launcher" android:hardwareAccelerated="true"
        android:largeHeap="true" android:allowBackup="false" android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
