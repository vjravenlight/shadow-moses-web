<?xml version="1.0" encoding="utf-8"?>
<!-- APK de Quest: abre https://mgs.ravenlight.net/casco/ en el navegador del casco, sin barra (Trusted Web Activity). Sale de la
     plantilla de Meta (@meta-quest/bubblewrap-core) en modo 2D: la primera pantalla pide el archivo .mgs, y el juego entra a
     realidad virtual con su botón. No lleva ningún archivo del juego. FeniXVOID · Project Ravenlight -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="net.ravenlight.shadowmoses.quest">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="false" android:version="1" />
    <queries>
        <intent><action android:name="android.support.customtabs.action.CustomTabsService" /></intent>
    </queries>
    <application android:label="@string/appName" android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">
        <meta-data android:name="asset_statements" android:resource="@string/assetStatements" />
        <activity android:name="com.meta.androidbrowserhelper.trusted.LauncherActivity" android:alwaysRetainTaskState="true"
            android:label="@string/appName" android:exported="true">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="@string/launchUrl" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="customtabs" />
            <meta-data android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION" android:value="any" />
            <meta-data android:name="horizonos.pwa.APP_MODE" android:value="2D" />
            <meta-data android:name="com.oculus.vrshell.uses_secure_layer" android:value="secure" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.2D" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="mgs.ravenlight.net" android:pathPrefix="/casco/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
